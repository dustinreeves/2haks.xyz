sdwan.2haks.xyz {
	encode zstd gzip
	root * /opt/apps/sdwan/public
	file_server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		Cache-Control no-cache
	}
	@wasm path *.wasm
	header @wasm Content-Type application/wasm
	@whl path *.whl
	header @whl Content-Type application/octet-stream
}
