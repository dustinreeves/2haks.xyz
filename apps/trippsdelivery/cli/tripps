#!/usr/bin/env python3
"""tripps: command line for Tripp's Delivery.

  tripps stock                 show the water left and the prices
  tripps order NAME [-w N] [-d N] [-l N]   place an order
  tripps orders [-n 20]        list recent orders   (needs the admin token)
  tripps refill N              set the water stock  (needs the admin token)

Environment: TRIPPS_API (default https://trippsdelivery.2haks.xyz),
TRIPPS_TOKEN (admin token; falls back to ADMIN_TOKEN in ../.env).
"""

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

API = os.environ.get("TRIPPS_API", "https://trippsdelivery.2haks.xyz").rstrip("/")


def token() -> str:
    if os.environ.get("TRIPPS_TOKEN"):
        return os.environ["TRIPPS_TOKEN"]
    env = Path(__file__).resolve().parent.parent / ".env"
    if env.exists():
        for line in env.read_text().splitlines():
            if line.startswith("ADMIN_TOKEN="):
                return line.split("=", 1)[1].strip()
    sys.exit("No admin token. Set TRIPPS_TOKEN or run this on the server next to .env")


def call(method: str, path: str, body: dict | None = None, admin: bool = False) -> dict:
    headers = {"Accept": "application/json"}
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    if admin:
        headers["Authorization"] = f"Bearer {token()}"
    req = urllib.request.Request(API + path, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as err:
        try:
            detail = json.load(err).get("detail", err.reason)
        except ValueError:
            detail = err.reason
        sys.exit(f"Error {err.code}: {detail}")
    except urllib.error.URLError as err:
        sys.exit(f"Could not reach {API}: {err.reason}")


def main() -> None:
    p = argparse.ArgumentParser(prog="tripps", description="Tripp's Delivery")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("stock")
    o = sub.add_parser("order")
    o.add_argument("name")
    o.add_argument("-w", "--water", type=int, default=0)
    o.add_argument("-d", "--dog", type=int, default=0)
    o.add_argument("-l", "--lawn", type=int, default=0)
    ls = sub.add_parser("orders")
    ls.add_argument("-n", "--limit", type=int, default=20)
    r = sub.add_parser("refill")
    r.add_argument("water", type=int)
    args = p.parse_args()

    if args.cmd == "stock":
        s = call("GET", "/api/stock")
        pr = s["prices"]
        print(f"Water left: {s['water']}")
        print(f"Prices: water ${pr['water']} each, dog sitting ${pr['dog']}, lawn mowing ${pr['lawn']}")
    elif args.cmd == "order":
        res = call("POST", "/api/orders", {"name": args.name, "water": args.water, "dog": args.dog, "lawn": args.lawn})
        print(f"Order #{res['id']} placed for {res['name']}. Total due: ${res['total']}. Water left: {res['water_left']}")
    elif args.cmd == "orders":
        for row in call("GET", f"/api/orders?limit={args.limit}", admin=True)["orders"]:
            when = time.strftime("%Y-%m-%d %H:%M", time.localtime(row["created"]))
            mail = "notified" if row["emailed"] else "NOT notified"
            print(f"#{row['id']:<4} {when}  {row['name']:<16} water {row['water']} dog {row['dog']} lawn {row['lawn']}  ${row['total']}  ({mail})")
    elif args.cmd == "refill":
        print("Water stock is now", call("PUT", "/api/stock", {"water": args.water}, admin=True)["water"])


if __name__ == "__main__":
    main()
